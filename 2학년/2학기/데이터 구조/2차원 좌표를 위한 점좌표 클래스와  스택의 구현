int main() {
  int a, b, c, d;
  stack * s = new stack();

  cin >> a >> b >> c >> d;
  s->Push(new point(a,b));
  s->Push(c,d);
  point * ppt = s->Pop();
  cout << ppt->x << " " << ppt->y << " ";
  delete ppt;
  ppt = s->Pop();
  cout << ppt->x << " " << ppt->y << endl;
  delete ppt;
  return 0;
};
