int main() {
	int d1, d2, d3;
	int x, y, z, v;

	cin >> d1 >> d2 >> d3;
	arrInt3 cube(d1, d2, d3);

	for (int i=0; i<3; i++) {
		cin >> x >> y >> z >> v;
		cube.SetAt(x, y, z, v);
	}

	cin >> x >> y >> z;
	cout << cube.GetAt(x, y, z) << endl;
}
