▣ 토의·토론 내용정리
#include <iostream>
#include <string>

using namespace std;

void countCharacters(const string& text) {
    int alphaCount = 0, digitCount = 0, spaceCount = 0;

    for (char c : text) {
        if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'))
            alphaCount++;
        else if (c >= '0' && c <= '9')
            digitCount++;
        else if (c == ' ')
            spaceCount++;
    }

    cout << "알파벳 글자의 개수: " << alphaCount << endl;
    cout << "숫자의 개수: " << digitCount << endl;
    cout << "공백 문자의 개수: " << spaceCount << endl;
}

void countWords(const string& text) {
    int wordCount = 0;
    bool inWord = false;

    for (char c : text) {
        if (c == ' ') {
            if (inWord) {
                wordCount++;
                inWord = false;
            }
        }
        else {
            inWord = true;
        }
    }

    if (inWord)
        wordCount++;

    cout << "단어의 개수: " << wordCount << endl;
}

void findAndReplace(string& text, const string& findStr, const string& replaceStr) {
    size_t pos = text.find(findStr);
    while (pos != string::npos) {
        text.replace(pos, findStr.length(), replaceStr);
        pos = text.find(findStr, pos + replaceStr.length());
    }
}

int main() {
    string input;

    cout << "텍스트를 입력하세요: ";
    getline(cin, input);

    cout << endl << "8번 결과" << endl;
    countCharacters(input);

    cout << endl << "9번 결과" << endl;
    countWords(input);

    cout << endl << "13번 결과" << endl;
    string findStr, replaceStr;
    cout << "찾을 문자열을 입력하세요: ";
    getline(cin, findStr);
    cout << "바꿀 문자열을 입력하세요: ";
    getline(cin, replaceStr);

    findAndReplace(input, findStr, replaceStr);
    cout << "변경된 문자열: " << input << endl;

    return 0;
}

