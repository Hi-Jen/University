#include <iostream>
#include <cmath>
using namespace std;

double dist_2d(int x1, int y1, int x2, int y2) {
    int a = x2 - x1;
    int b = y2 - y1;
    double c = sqrt((a * a) + (b * b));

    return sqrt((a * a) + (b * b));
}
void p9() {
    int x1, y1, x2, y2;
    cin >> x1 >> y1 >> x2 >> y2;
    cout << "첫번째 점의 좌표: " << x1 << y1 << endl;
    cout << "두번째 점의 좌표: " << x2 << y2 << endl;
    cout << dist_2d(x1, y1, x2, y2) << endl;
}
void quad_eqn(int a, int b, int c) {
    int discri = pow(b, 2) - 4 * (a * c);
    int val1, val2;
    if (discri < 0)
    {
        cout << "근이 없습니다.";
        return;
    }
    else
    {
        val1 = (-b + sqrt(pow(b, 2) - (4 * a * c))) / (2 * a);
        val2 = (-b - sqrt(pow(b, 2) - (4 * a * c))) / (2 * a);
    }
    cout << "첫번째 근: " << val1 << endl << "두번째 근: " << val2;
    return;
}
void p10() {
    int a, b, c;
    cin >> a >> b >> c;
    quad_eqn(a, b, c);
}
