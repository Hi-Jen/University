import matplotlib.pyplot as plt
import numpy as np
from skimage.morphology import binary_erosion, binary_dilation, binary_opening, binary_closing, rectangle, disk
from skimage import io, color

def plot_image(image, title=''):
    plt.imshow(image, cmap='gray')
    plt.axis('off')
    plt.title(title, size=20)

im = color.rgb2gray(io.imread('/content/drive/MyDrive/task/어깨걸이극락조.jpg'))
im[im <= 0.5] = 0  # 이진 영상 만들기
im[im > 0.5] = 1

# 1: Erosion (침식) 후 Dilation (팽창)
im_eroded = binary_erosion(im, disk(5))
im_dilated = binary_dilation(im_eroded, disk(5))

# 2: Closing 닫힘(팽창+침식) 후 Opening 열림(침식+팽창)
im_closed = binary_closing(im, disk(8))
im_opened = binary_opening(im_closed, disk(8))

plt.figure(figsize=(20, 10))
plt.subplot(151), plot_image(im, 'Original')
plt.subplot(152), plot_image(im_eroded, 'Erosion (disk 5)')
plt.subplot(153), plot_image(im_dilated, 'Erosion → Dilation')
plt.subplot(154), plot_image(im_closed, 'Closing (disk 8)')
plt.subplot(155), plot_image(im_opened, 'Closing → Opening')
plt.show()
